(namespace tools
  (defn ready (as-type (Fn () Bool) (fn () true)))
  (export ready))

(use ::tools::ready ready)
(defn startup-ready (as-type (Fn () Bool) (fn () (ready))))

(defn last-index
  (as-type (Fn (Nat Nat) Nat)
    (fn (index acc)
      (fold-nat index acc (index acc) index))))

(defn fold-sum
  (as-type (Fn (Nat Nat) Nat)
    (fn (index acc)
      (fold-nat index acc (index acc)
        (add acc (mul (sub (add index 2) 1) 2))))))

(defn parallel-bindings
  (as-type (Fn (Nat) Nat)
    (fn (x)
      (let ((x 4) (y x))
        (add x y)))))
