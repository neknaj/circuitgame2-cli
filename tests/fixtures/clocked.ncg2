(using nor)
(namespace tests
  (module oscillator (in) (out q)
    (def q (nor q q)))
  (memory bank (address 64) (data (bits 1)))
  (module capacity (in (a (bits 64)) d we) (out q)
    (def q (bank a d we)))
  (module bad-slice (in x) (out y))
  (module cycle (in) (out x) (def x y))
  (module selection-cycle (in) (out left)
    (def left (bit right 0)))
  (module concat-cycle (in) (out (x (bits 2)))
    (def x (concat 0 y)))
  (module concat-width (in (a (bits 65536)) b) (out q)
    (def q (concat a b))))
